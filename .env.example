POSTGRES_DB=netops
POSTGRES_USER=netops
POSTGRES_PASSWORD=netops
POSTGRES_PORT=5432

API_PORT=8080
WEB_PORT=3000

SESSION_SECRET=change-me-please-with-32-or-more-chars
LOG_LEVEL=info
CONFIG_APPLY_ENABLED=false
DRY_RUN_DEFAULT=true
NETBOX_ENABLED=false
NETBOX_URL=
NETBOX_TOKEN=
NETBOX_SKIP_TLS_VERIFY=false
NETBOX_TIMEOUT_MS=10000
NETBOX_PAGE_SIZE=100
NETOPS_SNMP_REAL_ENABLED=false
# Copilot operacional (read-only)
NETOPS_COPILOT_ENABLED=true
# NLU local (Ollama) — so para perguntas ambiguas; default off
NETOPS_COPILOT_NLU_ENABLED=false
NETOPS_COPILOT_NLU_BASE_URL=http://127.0.0.1:11434
NETOPS_COPILOT_NLU_MODEL=hermes3
NETOPS_COPILOT_NLU_TIMEOUT_MS=8000
NETOPS_COPILOT_NLU_MIN_CONFIDENCE=0.65
# SSH read-only sob demanda (RIB/prefixo ao vivo no copilot)
NETOPS_COPILOT_SSH_ON_DEMAND_ENABLED=false
NETOPS_COPILOT_SSH_MAX_PEERS=4
NETOPS_COPILOT_SSH_TIMEOUT_MS=45000
# Coleta SNMP read-only antes de queries BGP no copilot (requer NETOPS_SNMP_REAL_ENABLED)
NETOPS_COPILOT_INVENTORY_REFRESH_ENABLED=false
NETOPS_COPILOT_INVENTORY_REFRESH_MAX_DEVICES=2
# Consulta NetBox read-only no copilot (requer NETBOX_ENABLED + URL/token)
NETOPS_COPILOT_NETBOX_ENABLED=false
NETOPS_COPILOT_NETBOX_MAX_MATCHES=20
# * = all devices; or CSV e.g. 1,2,3 for restricted pilot
SNMP_FAST_PILOT_DEVICE_IDS=*
# Connectors / WireGuard (server side)
# NETOPS_WG_HUB_PRIVATE_KEY= só no host (.env), nunca commitar — par de NETOPS_WG_SERVER_PUBLIC_KEY
NETOPS_WG_SERVER_PUBLIC_KEY=
NETOPS_WG_HUB_PRIVATE_KEY=
NETOPS_WG_ENDPOINT=4wnet.devops.k3gsolutions.com.br:51820
NETOPS_WG_DEFAULT_ALLOWED_IPS=10.0.0.0/8,192.168.0.0/16
NETOPS_WG_SERVER_ADDRESS=10.255.0.1
NETOPS_WG_IP_POOL_BASE=10.255.0.
NETOPS_WG_PORT=51820
L2_DISCOVER_SSH_ENABLED=false
# Lab/NOC: set true to enable "Atualizar operacional" (SNMP + SSH read-only)
L2_OPERATIONAL_REFRESH_ENABLED=false
# Optional: include display current-configuration interface on refresh
L2_OPERATIONAL_REFRESH_SSH_CONFIG=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
